rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      // Users may edit their own public profile, but never moderation fields.
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['labels', 'admin', 'role']);
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read, create: if signedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId));
        }
        allow read: if signedIn() && request.auth.uid in parentChat().data.participants;
        allow create: if signedIn()
          && request.auth.uid in parentChat().data.participants
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }

    match /moderation/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
